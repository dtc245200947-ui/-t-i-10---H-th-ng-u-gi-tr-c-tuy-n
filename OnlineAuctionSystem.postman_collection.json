{
  "info": {
    "_postman_id": "d771e608-2a14-46f9-ab8e-e04b14ba7479",
    "name": "Online Auction API - Lab (Đề tài 10)",
    "description": "Bộ kiểm thử Postman Desktop tự động cho Đề tài 10 - Hệ thống Đấu giá Trực tuyến (.NET 10 Minimal API + gRPC + RabbitMQ + SignalR).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050",
      "type": "string"
    },
    {
      "key": "auctionId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"GET / trả về 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Tên dịch vụ và trạng thái đúng\", function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.service).to.equal(\"Auction.Api\");",
              "  pm.expect(data.status).to.equal(\"running\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "02 - List auctions",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"GET /auctions trả về 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Kết quả là mảng JSON các phiên đấu giá\", function () {",
              "  const data = pm.response.json();",
              "  pm.expect(Array.isArray(data)).to.equal(true);",
              "  pm.expect(data.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auctions",
          "host": ["{{baseUrl}}"],
          "path": ["auctions"]
        }
      }
    },
    {
      "name": "03 - Create auction - valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tạo phiên đấu giá trả về 201 Created\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"JSON có dữ liệu phản hồi hợp lệ\", function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.be.a(\"string\");",
              "  pm.expect(data.productName).to.equal(\"Laptop ASUS ROG Zephyrus G16 2026\");",
              "  pm.expect(data.startingPrice).to.equal(50000000);",
              "  pm.expect(data.currentPrice).to.equal(50000000);",
              "  pm.expect(data.status).to.equal(\"Open\");",
              "});",
              "pm.test(\"Location header chứa đường dẫn phiên đấu giá\", () => {",
              "  const location = pm.response.headers.get(\"Location\");",
              "  pm.expect(location).to.include(\"/auctions/\");",
              "});",
              "const response = pm.response.json();",
              "pm.collectionVariables.set(\"auctionId\", response.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"  Laptop ASUS ROG Zephyrus G16 2026  \",\n  \"productDescription\": \"Chính hãng bảo hành 24 tháng\",\n  \"startingPrice\": 50000000,\n  \"minIncrement\": 1000000,\n  \"durationMinutes\": 60\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auctions",
          "host": ["{{baseUrl}}"],
          "path": ["auctions"]
        }
      }
    },
    {
      "name": "04 - Create auction - blank name (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tên sản phẩm rỗng trả về 400 Bad Request\", () => {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Có thông báo lỗi tiếng Việt chuẩn\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.message).to.include(\"Tên sản phẩm\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"   \",\n  \"startingPrice\": 50000000,\n  \"minIncrement\": 1000000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auctions",
          "host": ["{{baseUrl}}"],
          "path": ["auctions"]
        }
      }
    },
    {
      "name": "05 - Create auction - invalid price <= 0 (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Giá khởi điểm <= 0 trả về 400 Bad Request\", () => {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Có thông báo lỗi giá khởi điểm\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.message).to.include(\"Giá khởi điểm phải lớn hơn 0\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"Laptop Gaming\",\n  \"startingPrice\": 0,\n  \"minIncrement\": 500000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auctions",
          "host": ["{{baseUrl}}"],
          "path": ["auctions"]
        }
      }
    },
    {
      "name": "06 - Get auction by ID - valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"GET /auctions/{id} trả về 200 OK\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Trả về đúng ID phiên đấu giá\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.equal(pm.collectionVariables.get(\"auctionId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auctions/{{auctionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["auctions", "{{auctionId}}"]
        }
      }
    },
    {
      "name": "07 - Place bid - valid (gRPC + RabbitMQ)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Đặt giá hợp lệ trả về 200 OK\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Phản hồi xác nhận thành công và có CorrelationId\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.success).to.equal(true);",
              "  pm.expect(data.currentPrice).to.equal(52000000);",
              "  pm.expect(data.currentWinner).to.equal(\"Trần Đức Nhân\");",
              "  pm.expect(data.correlationId).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bidderName\": \"Trần Đức Nhân\",\n  \"amount\": 52000000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auctions/{{auctionId}}/bids",
          "host": ["{{baseUrl}}"],
          "path": ["auctions", "{{auctionId}}", "bids"]
        }
      }
    },
    {
      "name": "08 - Place bid - rejected by gRPC (BID_TOO_LOW 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Giá đặt thấp hơn bước giá bị gRPC từ chối 400\", () => {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Mã lỗi trả về từ gRPC là BID_TOO_LOW\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.success).to.equal(false);",
              "  pm.expect(data.errorCode).to.equal(\"BID_TOO_LOW\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bidderName\": \"Lê Hoàng Nam\",\n  \"amount\": 52100000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auctions/{{auctionId}}/bids",
          "host": ["{{baseUrl}}"],
          "path": ["auctions", "{{auctionId}}", "bids"]
        }
      }
    },
    {
      "name": "09 - Get bid history",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"GET /auctions/{id}/bids trả về 200 OK\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Lịch sử trả giá chứa lượt trả hợp lệ vừa gửi\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(Array.isArray(data)).to.equal(true);",
              "  pm.expect(data.length).to.be.greaterThan(0);",
              "  pm.expect(data[0].bidderName).to.equal(\"Trần Đức Nhân\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auctions/{{auctionId}}/bids",
          "host": ["{{baseUrl}}"],
          "path": ["auctions", "{{auctionId}}", "bids"]
        }
      }
    },
    {
      "name": "10 - End auction & determine winner",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Kết thúc phiên trả về 200 OK\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Xác định đúng người chiến thắng và đóng phiên\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.status).to.equal(\"Closed\");",
              "  pm.expect(data.winner).to.equal(\"Trần Đức Nhân\");",
              "  pm.expect(data.finalPrice).to.equal(52000000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auctions/{{auctionId}}/end",
          "host": ["{{baseUrl}}"],
          "path": ["auctions", "{{auctionId}}", "end"]
        }
      }
    }
  ]
}
